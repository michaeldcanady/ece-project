# Copy to .devcontainer/.env (gitignored) and rebuild. Everything here is commented out, so a straight copy
# changes nothing: uncomment only what you want. Without this file the lake is the local docker volume.

# Record every published envelope (one gzip JSONL per ingest job) for a real sample capture.
# Visible from the dev shell under /lake/capture; replay it with the citibike_replay DAG.
# CB_CAPTURE_DIR=/opt/airflow/data/capture

# Write the lake to AWS S3 instead of the local docker volume. Uncomment the whole block together and fill in
# a real bucket and credentials; with CB_STORAGE=s3 every pipeline task fails until they are valid.
# CB_STORAGE=s3
# CB_S3_BUCKET=your-bucket
# CB_S3_PREFIX=citibike
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
